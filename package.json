{
    "name": "cliuno",
    "version": "2.2.0",
    "description": "CLIuno is a CLI tool to make your journey in web development less painful (it makes your life way easier).",
    "keywords": [
        "agent-skills",
        "all in one",
        "all-in-1",
        "all-in-one",
        "automation",
        "claude-code",
        "claude-skills",
        "cli",
        "cliuno",
        "generator",
        "javascript",
        "nodeJs",
        "scaffold",
        "typescript"
    ],
    "homepage": "https://github.com/CLIuno/core#readme",
    "bugs": {
        "url": "https://github.com/CLIuno/core/issues"
    },
    "license": "MIT",
    "author": "ru44",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CLIuno/core.git"
    },
    "bin": {
        "cliuno": "dist/app.js"
    },
    "files": [
        "dist",
        "skills"
    ],
    "type": "module",
    "main": "dist/app.js",
    "module": "dist/app.js",
    "types": "dist/app.d.ts",
    "scripts": {
        "lint": "oxlint",
        "lintfix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "dev": "tsx ./src/app.ts",
        "test:matrix": "node scripts/test-matrix.mjs",
        "build": "tsup",
        "release": "pnpm build && changeset publish",
        "prepare": "husky",
        "test": "node --import tsx --test \"src/**/*.test.ts\"",
        "prebuild": "node scripts/stamp-version.mjs",
        "changeset:version": "changeset version && node scripts/stamp-version.mjs"
    },
    "dependencies": {
        "@inquirer/prompts": "^8.7.3",
        "chalk": "^6.0.1",
        "shelljs": "^0.10.0"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.3",
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@types/node": "^26.6.4",
        "@types/shelljs": "^0.10.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "tsup": "^8.5.1",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3"
    },
    "lint-staged": {
        "**/*.{js,ts}": [
            "pnpm lintfix"
        ]
    }
}
